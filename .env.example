# ==============================================================================
# OCI Generative AI & WhatsApp Agent Environment Configuration
# ==============================================================================

# OCI Generative AI Service Configuration
COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_ocid
ENDPOINT=https://inference.generativeai.me-riyadh-1.oci.oraclecloud.com
MODEL_ID=ocid1.generativeaimodel.oc1.me-riyadh-1.your_model_ocid
OCI_CONFIG_FILE=config

# Optional Direct API Key (OpenAI-compatible OCI GenAI endpoint)
keyone=your_oci_genai_api_key
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_ocid

# Redis Session Memory Cache
REDIS_HOST=localhost
REDIS_PORT=6379
EXPIRE_TIME=86400
MAX_HISTORY_MESSAGES=20

# Twilio WhatsApp API Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_TO_NUMBER=whatsapp:+1234567890
